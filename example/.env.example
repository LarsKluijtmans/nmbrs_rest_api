# Nmbrs OAuth application credentials (developer.nmbrs.com).
# Keep this file out of version control.
NMBRS_CLIENT_ID=
NMBRS_CLIENT_SECRET=
NMBRS_SUBSCRIPTION_KEY=
NMBRS_REDIRECT_URI=

# Written automatically after a successful login. Refresh tokens rotate, so this
# is rewritten every time the SDK refreshes - do not edit it by hand.
NMBRS_REFRESH_TOKEN=
